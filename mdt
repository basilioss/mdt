#!/bin/sh
# https://github.com/basilioss/mdt

# Configuration ################################

dir="${MDT_DIR}"
inbox="${MDT_INBOX}"
add_multiple_tasks="${MDT_ADD_MULTIPLE_TASKS:-0}"
unite_tasks="${MDT_UNITE_TASKS:-0}"
display_titles="${MDT_DISPLAY_TITLES:-0}"
todo_filename="${MDT_NEW_FILE_NAMES}"
color="${MDT_MAIN_COLOR:-5}"
prompt="${MDT_PROMPT:-◆}"
cursor="${MDT_CURSOR:-➔}"
item_width="${MDT_ITEM_WIDTH:-75}"
input_width="${MDT_INPUT_WIDTH:-65}"
file_editor="${MDT_EDITOR:-${EDITOR}}"
checkbox_prefix="${MDT_CHECKBOX_PREFIX:--}"

################################################

me="${0##*/}"
mdt_version="1.4.0"

print_help() {
  printf %s "\
${me} - command-line markdown todo list manager

Usage
  ${me} [options]
  ${me} <task>                  Add task directly

Quick Actions (no gum required)
  -l, --list [FILTER]     List tasks (filter by keyword if specified)
  -c, --complete N        Toggle task N complete/incomplete
  -d, -D, --delete N      Delete task N
  -e, --edit [N]          Open in editor (at task N if specified)
  --clear                 Remove all completed tasks

Interactive Mode
  -a, --add [TASK]        Add task (interactive if TASK omitted)
  -m, --add-multiple      Add multiple tasks at once
  -u, --unite-tasks       List all tasks ignoring headers

Configuration
  --dir                   Path to tasks directory (default: current)
  --inbox                 Path to inbox file (default: TODO.md)
  --editor                Editor command (default: \$EDITOR or system default)
  --color                 Main color
  --display-titles        Show heading instead of filename

  -v, --version           Print version
  -h, --help              Print help
"
  exit 0
}

parse_commandline() {
  _positional_args=""
  while test $# -gt 0; do
    _key="$1"
    case "${_key}" in
      --dir) dir="$2" && shift ;;
      --dir=*) dir="${_key##--dir=}" ;;
      -d | -D | --delete)
        delete_task_num="$2" && shift
        ;;
      -c | --complete)
        complete_task_num="$2" && shift
        ;;
      --inbox) inbox="$2" && shift ;;
      --inbox=*) inbox="${_key##--inbox=}" ;;
      -m | --add-multiple) add_multiple_tasks=1 ;;
      -u | --unite-tasks) unite_tasks=1 ;;
      -l | --list)
        list_inbox_mode=1
        # Check if next arg is a filter keyword (not a flag)
        if [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; then
          list_filter="$2" && shift
        fi
        ;;
      --clear) clear_completed_mode=1 ;;
      -a | --add)
        # Check if next arg exists and isn't a flag (for non-interactive add)
        if [ $# -gt 1 ] && [ "${2#-}" = "$2" ]; then
          quick_add_task="$2"
          shift
        fi
        choice="Add to inbox"
        ;;
      -e | --edit)
        edit_inbox_mode=1
        # Check if next arg is a task number
        if [ $# -gt 1 ] && printf "%s" "$2" | grep -qE '^[0-9]+$'; then
          edit_task_num="$2" && shift
        fi
        ;;
      --display-titles) display_titles=1 ;;
      --todo-filename) todo_filename="$2" && shift ;;
      --todo-filename=*) todo_filename="${_key##--todo-filename=}" ;;
      --color) color="$2" && shift ;;
      --color=*) color="${_key##--color=}" ;;
      --prompt) prompt="$2" && shift ;;
      --prompt=*) prompt="${_key##--prompt=}" ;;
      --cursor) cursor="$2" && shift ;;
      --cursor=*) cursor="${_key##--cursor=}" ;;
      --item-width) item_width="$2" && shift ;;
      --item-width=*) item_width="${_key##--item-width=}" ;;
      --input-width) input_width="$2" && shift ;;
      --input-width=*) input_width="${_key##--input-width=}" ;;
      --editor) file_editor="$2" && shift ;;
      --editor=*) file_editor="${_key##--editor=}" ;;
      -v | --version) printf "%s\n" "${me} ${mdt_version}" && exit ;;
      -h | --help) print_help ;;
      *)
        # Collect positional arguments as task text
        if [ -z "${_positional_args}" ]; then
          _positional_args="$1"
        else
          _positional_args="${_positional_args} $1"
        fi
        ;;
    esac
    shift
  done

  # If positional arguments were provided, treat them as a task to add
  if [ -n "${_positional_args}" ]; then
    quick_add_task="${_positional_args}"
    choice="Add to inbox"
  fi
}

die() {
  printf 'Error: %s.\n' "$1" >&2
  exit 1
}

gum_choose() {
  gum choose --item.width="${item_width}" \
    --selected.foreground="${color}" \
    --cursor.foreground="${color}" \
    --cursor="${cursor} " "$@"
}

gum_input() {
  gum input --prompt="${prompt} " \
    --prompt.foreground="${color}" \
    --width="${input_width}" "$@"
}

create_file_if_missing() {
  _file="$1"
  _title="$2"
  _basename="$(basename "${_file}" .md)"

  [ -f "${_file}" ] && return

  gum confirm \
    --selected.background="${color}" \
    --selected.foreground="#262626" \
    --prompt.padding="0 2" \
    "File does not exist, create?"

  # Exit if the answer is "No"
  [ ! $? -eq 0 ] && exit

  if [ -n "${_title}" ]; then
    printf "%s\n\n" "# ${_title}" > "${_file}"
  else
    printf "%s\n\n" "# ${_basename}" > "${_file}"
  fi
}

get_file_with_checkboxes() {
  # If checkbox type isn't specified, use any
  # For example: [x] [ ] [-] [/] [>] [<] ...
  _checkbox_type="${1:-.}"
  _checkbox_pattern="^[[:space:]]*(-|\*|\+) \[${_checkbox_type}\]"
  _separator="@@@"

  # Do not search recursively if $dir isn't specified
  if [ "${isDirNotSpecified}" ]; then
    _files="$(ls -1 -t -- *.md | tr "\n" "\0" |
      xargs -0 grep -E --files-with-matches "${_checkbox_pattern}")"
  else
    _files="$(find * -name '*.md' -not -path '*/.*' \
      -exec ls -1 -t -- {} + | tr "\n" "\0" |
      xargs -0 grep -E --files-with-matches "${_checkbox_pattern}")"
  fi

  [ -z "${_files}" ] && die "No todo files found"

  if [ "${display_titles}" = true ] || [ "$display_titles" = 1 ]; then
    _titles_file=$(mktemp) # Create a temporary file
    printf "%s\n" "${_files}" | while read -r file; do
      title=$(sed -n '/^# .*/{p;q;}' "${file}" | sed 's/^# *//')
      [ -z "${title}" ] && title="${file}"
      printf "%s\n" "${title}${_separator}${file}" >> "${_titles_file}"
    done
    _files=$(cat "${_titles_file}")
    rm "${_titles_file}"
  fi

  _filename=$(printf "%s\n" "${_files}" | sed "s/${_separator}.*//g" |
    gum filter --no-strict \
      --indicator="${cursor}" \
      --prompt="${prompt} " \
      --indicator.foreground="${color}" \
      --match.foreground="${color}")

  [ -z "${_filename}" ] && exit

  if [ "${display_titles}" = true ] || [ "${display_titles}" = 1 ]; then
    _file="$(printf "%s\n" "${_files}" |
      awk -F "${_separator}" -v file="${_filename}" '$1 == file {print $2}')"
  fi

  [ -z "${_file}" ] && _file="${_filename}"

  # Remove .md file extensions if exist
  [ "${_file##*.}" = "md" ] && _file="${_file%.*}"

  # Build full path, but avoid doubling if already absolute
  if [ -z "${_file}" ]; then
    exit
  elif [ "${_file#/}" != "${_file}" ]; then
    # Already absolute path (starts with /)
    _file="${_file}.md"
  else
    # Relative path, prepend dir
    _file="${dir}/${_file}.md"
  fi

  if [ -n "${todo_filename}" ]; then
    _title="${_filename}"
    [ ! -f "${_file}" ] && _file="${todo_filename}.md"
  fi

  # Create a new file only if checkbox type isn't specified because
  # we can't list tasks from a non-existent file that doesn't have them
  [ "${_checkbox_type}" = '.' ] && create_file_if_missing "${_file}" "${_title}"

  # Return path to the file
  [ -f "${_file}" ] && printf "%s\n" "${_file}"
}

get_header_with_tasks() {
  _headers="$(awk \
    '/^#/ { header = $0 } /^[-*+] \[.]/ { print header; header = "" }' \
    "${_file}" | grep --invert-match '^$')"

  _header_count="$(printf "%s\n" "${_headers}" | wc -l | tr -d ' ')"

  if [ "${_header_count}" -gt 1 ]; then
    _header="$(printf "%s\n" "${_headers}" | gum_choose)"
    [ -z "${_header}" ] && return 1  # ESC pressed, signal to go back
    _multiple_headers=1
  else
    _header="${_headers}"
  fi

  [ -z "${_header}" ] && grep "^#.*" "${_file}" | head -1
  printf "%s" "${_header}"
}

list_open_todos() {
  [ -f "$1" ] && _file="$1" || return 1

  if ! grep -E --quiet --no-messages "(-|\*|\+) \[ \]" "${_file}"; then
    printf "%b\n" "Yey,\033[38;5;${color}m nothing\033[m left to do!" && return 0
  fi

  if [ "${unite_tasks}" = true ] || [ "${unite_tasks}" = 1 ]; then
    _items="$(grep -E "(-|\*|\+) \[ \] " "${_file}")"
    _multiple_headers=0
  else
    # Check if there are multiple headers (before entering loop)
    _headers="$(awk \
      '/^#/ { header = $0 } /^[-*+] \[.]/ { print header; header = "" }' \
      "${_file}" | grep --invert-match '^$')"
    _header_count="$(printf "%s\n" "${_headers}" | wc -l | tr -d ' ')"
    [ "${_header_count}" -gt 1 ] && _multiple_headers=1 || _multiple_headers=0
  fi

  # Loop to allow going back to header selection
  while true; do
  _selected_items=""
    if [ "${unite_tasks}" != true ] && [ "${unite_tasks}" != 1 ]; then
      # Check if file has any headers with tasks
      if [ -n "${_headers}" ]; then
        _header="$(get_header_with_tasks)"
        # shellcheck disable=SC2181
        [ $? -ne 0 ] && return 1  # ESC at header selection, go back to main menu
        [ -z "${_header}" ] && return 1
        _items="$(awk -v header="${_header}" \
          '$0 ~ header {p=1; next} /^#/ {p=0} p && /[-*+] \[ ] / {print}' "${_file}")"
      else
        # No headers, show all open tasks
        _items="$(grep -E "(-|\*|\+) \[ \] " "${_file}")"
      fi
    fi

    if [ -n "${_items}" ]; then
      # Add "└─ " at the beginning for subtasks
      _selected_items="$(printf "%s\n" "${_items}" |
        sed 's/^ \{0,1\}[-*+] \[ \] //g' |
        sed 's/^[[:space:]]*[-*+] \[ \] /└─ /g' |
        gum_choose --no-limit \
          --cursor-prefix "[ ] " \
          --selected-prefix "[✓] " \
          --unselected-prefix "[ ] ")"
    fi

    # ESC or empty selection: go back if multiple headers, otherwise return to main menu
    if [ -z "${_selected_items}" ]; then
      [ "${_multiple_headers}" = 1 ] && continue || return 0
    fi

    # Process selected items
    printf "%s\n" "${_selected_items}" | while read -r item; do
      escaped_item=$(printf '%s\n' "${item}" |
        sed 's/└─ //g' |
        sed 's/[*[\/&]/\\&/g')
      sed_script=$(printf 's/\\[ \\] %s/\\[x\\] %s/g' "${escaped_item}" "${escaped_item}")
        sed "${sed_script}" "${_file}" > "${_file}.bak" && mv "${_file}.bak" "${_file}"
    done
    break
  done
}

add_todo() {
  [ -f "$1" ] && _file="$1" || return 1

  # Check if file has headers with tasks
  _headers="$(awk \
    '/^#/ { header = $0 } /^[-*+] \[.]/ { print header; header = "" }' \
    "${_file}" | grep --invert-match '^$')"

  if [ -n "${_headers}" ]; then
    _header="$(get_header_with_tasks)" || return 1
  fi

  if [ "${add_multiple_tasks}" = true ] || [ "${add_multiple_tasks}" = 1 ]; then
    while true; do
      _input="$(gum_input --placeholder "Press Esc or Enter to exit")"
      [ -z "${_input}" ] && break || _items="${_items}\n${_input}"
    done
  else
    _items="$(gum_input --placeholder "Got something to do?")"
  fi

  [ -z "${_items}" ] && return 0

  printf "%b\n" "${_items}" | while read -r _item; do
    [ -z "${_item}" ] && continue

    # Get line number of the first task under the header
    _line="$(awk -v header="${_header}" \
      '$0 ~ header {p=1; next} /^#/ {p=0} \
      p && /^[-*+] \[.]/ && !found {line=NR; found=1} \
      END {print line}' "${_file}")"

    # Add a checkbox before $_item if it isn't explicitly specified
    # Example checkboxes for inspiration:
    # https://minimal.guide/Block+types/Checklists#Checkbox+icons
    _checkbox="$(printf "%s\n" "${_item}" | grep --only-matching "^\[.\?\] ")"
    [ -z "${_checkbox}" ] && _item="[ ] ${_item}"

    if [ -z "${_line}" ]; then
      printf "%s\n" "${checkbox_prefix} ${_item}" >> "${_file}"
    else
      awk -v line="${_line}" -v todo="${checkbox_prefix} ${_item}" \
        'NR==line{print todo}1' \
        "${_file}" > "${_file}.bak" && mv "${_file}.bak" "${_file}"
    fi
  done
}

# Get line number in file for task N
get_task_line_num() {
  _file="$1"
  _task_num="$2"
  [ ! -f "${_file}" ] && return 1

  _tasks="$(grep -nE "^[[:space:]]*(-|\*|\+) \[.\]" "${_file}")"
  [ -z "${_tasks}" ] && return 1

  printf "%s\n" "${_tasks}" | sed -n "${_task_num}p" | cut -d: -f1
}

edit_todo() {
  [ -f "$1" ] && _file="$1" || return 1
  _line_num="$2"

  # Use configured editor, or fall back to system default
  if [ -z "${file_editor}" ]; then
    # Note: line number not supported with system default
    [ -n "${_line_num}" ] && printf "Note: Set \$EDITOR to jump to specific lines\n"
    # macOS: use 'open' to launch default app
    if command -v open > /dev/null 2>&1; then
      open "${_file}"
      return 0
    fi
    # Linux: try xdg-open
    if command -v xdg-open > /dev/null 2>&1; then
      xdg-open "${_file}"
      return 0
    fi
    # No fallback available
    printf "No editor configured. Set one of these in your shell profile:\n\n"
    printf "  export EDITOR=nano           # simple editor\n"
    printf "  export EDITOR=vim            # vim\n"
    printf "  export EDITOR='code --wait'  # VS Code\n"
    printf "  export MDT_EDITOR=nano       # mdt-specific override\n\n"
    printf "Add the line to ~/.bashrc, ~/.zshrc, or ~/.profile\n"
    exit 1
  fi

  if [ -n "${_line_num}" ]; then
    # Open editor at specific line - syntax varies by editor
    case "${file_editor}" in
      *code*|*codium*)
        # VS Code / Codium: code -g file:line
        eval "${file_editor}" "-g \"${_file}:${_line_num}\""
        ;;
      *subl*|*sublime*)
        # Sublime Text: subl file:line
        eval "${file_editor}" "\"${_file}:${_line_num}\""
        ;;
      *)
        # Most editors (vim, nvim, nano, emacs, etc): editor +line file
        eval "${file_editor}" "+${_line_num}" "\"${_file}\""
        ;;
    esac
  else
    eval "${file_editor}" "\"${_file}\""
  fi
}

# Non-interactive add: appends a task directly to the file
quick_add_todo() {
  _file="$1"
  _task="$2"

  # Create file with header if it doesn't exist
  if [ ! -f "${_file}" ]; then
    _basename="$(basename "${_file}" .md)"
    printf "%s\n\n" "# ${_basename}" > "${_file}"
  fi

  # Add checkbox prefix if not already present
  _checkbox="$(printf "%s\n" "${_task}" | grep --only-matching "^\[.\?\] ")"
  [ -z "${_checkbox}" ] && _task="[ ] ${_task}"

  # Ensure file ends with newline before appending
  [ -n "$(tail -c 1 "${_file}")" ] && printf "\n" >> "${_file}"
  printf "%s %s\n" "${checkbox_prefix}" "${_task}" >> "${_file}"
  printf "✓ Added: %s\n" "${_task}"
}

# List all tasks with line numbers (non-interactive)
list_tasks_numbered() {
  _file="$1"
  _recursive="$2"
  _filter="$3"
  _all_tasks=""

  if [ -n "${_recursive}" ]; then
    # Find all TODO.md files in current dir and subdirs
    _files="${_file}"
    for _subfile in */TODO.md; do
      [ -f "${_subfile}" ] && _files="${_files}
${_subfile}"
    done
  else
    _files="${_file}"
  fi

  # Collect all tasks with folder prefixes
  for _current_file in $(printf "%s\n" "${_files}"); do
    [ ! -f "${_current_file}" ] && continue

    # Get folder prefix for subfolder files
    _folder=""
    if [ "${_current_file}" != "${_file}" ]; then
      _folder="$(dirname "${_current_file}")"
    fi

    while IFS= read -r line; do
      [ -z "${line}" ] && continue
      _content="${line#*:}"
      _task_text="$(printf "%s" "${_content}" | sed 's/^[[:space:]]*[-*+] \[.\] //')"

      # Add folder prefix if from subfolder
      if [ -n "${_folder}" ]; then
        _task_text="[${_folder}] ${_task_text}"
      fi

      # Apply filter if specified
      if [ -n "${_filter}" ]; then
        printf "%s" "${_task_text}" | grep -qi "${_filter}" || continue
      fi

      # Mark completed tasks with a special prefix
      if printf "%s" "${_content}" | grep -qE "\[x\]"; then
        _all_tasks="${_all_tasks}DONE:${_task_text}
"
      else
        _all_tasks="${_all_tasks}TODO:${_task_text}
"
      fi
    done <<EOF
$(grep -nE "^[[:space:]]*(-|\*|\+) \[.\]" "${_current_file}" 2>/dev/null)
EOF
  done

  if [ -z "${_all_tasks}" ]; then
    if [ ! -f "${_file}" ] && [ -z "${_recursive}" ]; then
      die "File not found: ${_file}"
    fi
    printf "No tasks found.\n"
    return 0
  fi

  # Output with proper numbering and count stats
  _num=1
  printf "%s" "${_all_tasks}" | while IFS= read -r line; do
    [ -z "${line}" ] && continue
    _status="${line%%:*}"
    _task="${line#*:}"
    if [ "${_status}" = "DONE" ]; then
      printf "\033[9m%d. %s\033[0m\n" "${_num}" "${_task}"
    else
      printf "%d. %s\n" "${_num}" "${_task}"
    fi
    _num=$((_num + 1))
  done

  # Count tasks for summary
  _total=$(printf "%s" "${_all_tasks}" | grep -c "^TODO:\|^DONE:")
  _done=$(printf "%s" "${_all_tasks}" | grep -c "^DONE:")
  _open=$((_total - _done))
  printf "\n\033[2m%d tasks (%d open, %d done)\033[0m\n" "${_total}" "${_open}" "${_done}"
}

# Remove all completed tasks from inbox
clear_completed() {
  _file="$1"
  [ ! -f "${_file}" ] && die "File not found: ${_file}"

  _count=$(grep -cE "^[[:space:]]*(-|\*|\+) \[x\]" "${_file}" 2>/dev/null || echo "0")

  if [ "${_count}" -eq 0 ]; then
    printf "No completed tasks to clear.\n"
    return 0
  fi

  # Remove lines with completed tasks
  sed -i.bak '/^[[:space:]]*[-*+] \[x\]/d' "${_file}" && rm -f "${_file}.bak"
  printf "✓ Cleared %d completed task(s)\n" "${_count}"
}

# Delete task by number
delete_task() {
  _file="$1"
  _task_num="$2"
  [ ! -f "${_file}" ] && die "File not found: ${_file}"

  # Get all task lines with their line numbers
  _tasks="$(grep -nE "^[[:space:]]*(-|\*|\+) \[.\]" "${_file}")"
  _total="$(printf "%s\n" "${_tasks}" | wc -l | tr -d ' ')"

  if [ -z "${_tasks}" ] || [ "${_total}" -eq 0 ]; then
    die "No tasks found"
  fi

  if [ "${_task_num}" -lt 1 ] || [ "${_task_num}" -gt "${_total}" ]; then
    die "Invalid task number: ${_task_num} (valid: 1-${_total})"
  fi

  # Get the actual line number in the file for task N
  _line_num="$(printf "%s\n" "${_tasks}" | sed -n "${_task_num}p" | cut -d: -f1)"
  _task_text="$(printf "%s\n" "${_tasks}" | sed -n "${_task_num}p" | cut -d: -f2- | sed 's/^[[:space:]]*[-*+] \[.\] //')"

  # Delete the line
  sed "${_line_num}d" "${_file}" > "${_file}.bak" && mv "${_file}.bak" "${_file}"
  printf "✗ Deleted: %s\n" "${_task_text}"
}

# Toggle completion of task by number
complete_task() {
  _file="$1"
  _task_num="$2"
  [ ! -f "${_file}" ] && die "File not found: ${_file}"

  # Get all task lines with their line numbers
  _tasks="$(grep -nE "^[[:space:]]*(-|\*|\+) \[.\]" "${_file}")"
  _total="$(printf "%s\n" "${_tasks}" | wc -l | tr -d ' ')"

  if [ -z "${_tasks}" ] || [ "${_total}" -eq 0 ]; then
    die "No tasks found"
  fi

  if [ "${_task_num}" -lt 1 ] || [ "${_task_num}" -gt "${_total}" ]; then
    die "Invalid task number: ${_task_num} (valid: 1-${_total})"
  fi

  # Get the actual line number in the file
  _line_num="$(printf "%s\n" "${_tasks}" | sed -n "${_task_num}p" | cut -d: -f1)"
  _line_content="$(sed -n "${_line_num}p" "${_file}")"
  _task_text="$(printf "%s" "${_line_content}" | sed 's/^[[:space:]]*[-*+] \[.\] //')"

  # Toggle the checkbox
  if printf "%s" "${_line_content}" | grep -qE "\[ \]"; then
    # Mark as complete
    _new_line="$(printf "%s" "${_line_content}" | sed 's/\[ \]/[x]/')"
    printf "✓ Completed: %s\n" "${_task_text}"
  else
    # Mark as incomplete
    _new_line="$(printf "%s" "${_line_content}" | sed 's/\[x\]/[ ]/')"
    printf "○ Reopened: %s\n" "${_task_text}"
  fi

  # Replace the line
  sed "${_line_num}s/.*/${_new_line}/" "${_file}" > "${_file}.bak" && mv "${_file}.bak" "${_file}"
}

# If inbox isn't specified, use default.
# If it doesn't exist, ask to create.
set_inbox() {
  _default_inbox="${dir}/TODO.md"
  inbox="${inbox:-$_default_inbox}"

  if [ ! -f "${inbox}" ]; then
    create_file_if_missing "${inbox}"
    [ -f "${inbox}" ] && printf "%s\n" "${inbox} has been successfully created"
    exit 0
  fi
}

main() {
  parse_commandline "$@"

  if [ -z "${dir}" ]; then
    dir="${PWD}"
    isDirNotSpecified=1
  else
    cd "${dir}" || die "Directory does not exist"
  fi

  inbox="${inbox:-${dir}/TODO.md}"

  # Quick action modes (non-interactive, no gum required)
  if [ -n "${list_inbox_mode}" ]; then
    # Always scan subfolders by default
    list_tasks_numbered "${inbox}" "1" "${list_filter}"
    exit 0
  fi

  if [ -n "${clear_completed_mode}" ]; then
    clear_completed "${inbox}"
    exit 0
  fi

  if [ -n "${delete_task_num}" ]; then
    delete_task "${inbox}" "${delete_task_num}"
    exit 0
  fi

  if [ -n "${complete_task_num}" ]; then
    complete_task "${inbox}" "${complete_task_num}"
    exit 0
  fi

  if [ -n "${edit_inbox_mode}" ]; then
    # Create inbox if it doesn't exist
    if [ ! -f "${inbox}" ]; then
      printf "%s\n\n" "# TODO" > "${inbox}"
    fi
    if [ -n "${edit_task_num}" ]; then
      _line="$(get_task_line_num "${inbox}" "${edit_task_num}")"
      [ -z "${_line}" ] && die "Task ${edit_task_num} not found"
      edit_todo "${inbox}" "${_line}"
    else
      edit_todo "${inbox}"
    fi
    exit 0
  fi

  # Interactive modes require gum
  command -v gum > /dev/null || die "gum is required but not installed, exiting"

  # Main menu loop - ESC at sub-levels returns here
  while true; do
    if [ -z "${choice}" ]; then
      choice="$(gum_choose "List inbox" "Add to inbox" "List" "Add" "Edit")"
    fi

    # ESC at main menu exits
    [ -z "${choice}" ] && exit 0

    case "${choice}" in
      "List")
        list_open_todos "$(get_file_with_checkboxes ' ')"
        ;;
      "List inbox")
        set_inbox && list_open_todos "${inbox}"
        ;;
      "Add")
        add_todo "$(get_file_with_checkboxes)"
        ;;
      "Add to inbox")
        if [ -n "${quick_add_task}" ]; then
          # Non-interactive mode
          quick_add_todo "${inbox}" "${quick_add_task}"
          exit 0
        else
          set_inbox && add_todo "${inbox}"
        fi
        ;;
      "Edit")
        edit_todo "$(get_file_with_checkboxes)"
        ;;
    esac

    # Reset choice for next iteration (allows returning to main menu)
    choice=""
  done
}

main "$@"
